  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
